/web/domowik_bridge.wasm
/web/domowik_renderer*
/web/fallback-fonts/
/web/assets/fallback-fonts/

# Copies of the browser core beside the browser tests (issue 0088).
/test/web/domowik_bridge.wasm
/test/web/domowik_renderer*
/test/web/fallback-fonts/
/test/web/assets/fallback-fonts/

# Pinned test browsers (scripts/chrome-for-testing.sh).
/.tools/
